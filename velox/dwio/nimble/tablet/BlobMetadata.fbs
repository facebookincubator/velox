include "Footer.fbs";

namespace facebook.nimble.serialization;

/// Physical run of blob payload bytes. Carries no store id: a segment is nested
/// under the BlobGroup that owns it. Its position in that group's segment list
/// is its id, which is what BlobEntry.segment_id refers to.
table BlobSegment {
  first_row:uint64;
  row_count:uint32;
  file_offset:uint64;
  compressed_size:uint32;
  uncompressed_size:uint32;
  /// Applies to the segment as a whole, so a reader restores it before slicing
  /// any payload out of it. Independent of BlobEntry.compression_type, which
  /// sits inside this one: a segment may carry both, either, or neither.
  compression_type:CompressionType;
  checksum_type:uint8 = 0;
  checksum:uint64;
}

/// Per-blob lookup entry. Resolves one blob id to a byte range inside one of
/// the segments of the enclosing group. Carries no store id: every entry in an
/// entry list belongs to that list's group.
///
/// 'offset_in_segment' and 'size' address the segment's uncompressed bytes.
/// When 'compression_type' is set, those bytes are a compressed frame holding
/// this blob alone and 'uncompressed_size' is what they expand to; otherwise
/// the two sizes are equal. This compression sits inside the segment's own: a
/// reader restores the segment first, then expands the blob it wants.
table BlobEntry {
  blob_id:uint64;
  checksum:uint64;
  segment_id:uint32;
  offset_in_segment:uint32;
  size:uint32;
  uncompressed_size:uint32;
  compression_type:CompressionType;
}

/// One entry list. Written as its own section elsewhere in the file, never
/// inlined into the root manifest, because entry counts are proportional to the
/// number of blobs. This table exists only to give the vector a FlatBuffers
/// root; it has no counterpart type in C++, where an entry list is a plain
/// std::vector<BlobEntry>.
table BlobEntries {
  entries:[BlobEntry];
}

/// Everything the reader needs for one blob store: where its payload bytes are,
/// and where the entry list that addresses them is. A group is identified by
/// (blob_store_id, stripe_id): one blob store within one stripe. Both the
/// segments and the entry list it holds cover only that stripe, which is what
/// lets a reader load blob metadata for the stripes it touches and no others.
///
/// Segments are nested because there are only a handful per group, so inlining
/// them costs nothing and lets them drop their store id. Entries are not: their
/// count is proportional to the number of blobs, and a nested table would place
/// every one of them inside the manifest. 'entries' is therefore a
/// MetadataSection, a file offset, because FlatBuffers offsets are relative to
/// the buffer being parsed and cannot refer to another region of the file.
table BlobGroup {
  blob_store_id:uint32;
  stripe_id:uint32;
  segments:[BlobSegment];
  entry_count:uint32;
  entries:MetadataSection;
}

/// Root table for the blob metadata optional section ("blob.metadata").
///
/// 'groups' is ordered by (stripe_id, blob_store_id). That is the order a
/// writer produces naturally -- stripes are written in sequence, and each
/// stripe emits its stores -- and holding to it keeps every group of a stripe
/// adjacent, so a reader can binary search for the stripe it is decoding.
table BlobMetadata {
  version:uint32 = 1;
  groups:[BlobGroup];
}

root_type BlobMetadata;
