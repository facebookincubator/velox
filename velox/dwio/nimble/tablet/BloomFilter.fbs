namespace facebook.nimble.serialization;

/// Bloom filter for fast negative lookups.
table BloomFilter {
  /// Deprecated: the block count is derived from the filter payload, whose
  /// trailer identifies the layout that fixes the block size.
  num_blocks:uint32 (deprecated);
  /// Bits per key used during construction (for diagnostics/rebuild).
  bits_per_key:float;
  /// Serialized filter produced by the bloom filter builder. Self-describing:
  /// a trailer records the layout, so a reader needs nothing from this table
  /// to interpret it.
  data:[uint8];
}
