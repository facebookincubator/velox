setlocal
set "PATH=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer;%PATH%"
call "@CMAKE_GENERATOR_INSTANCE@\Common7\Tools\VsDevCmd.bat" -no_logo -arch=x64 -host_arch=x64
if errorlevel 1 exit /b %errorlevel%
"@CMAKE_VS_MSBUILD_COMMAND@" "%~1\source\allinone\allinone.sln" /nologo /verbosity:minimal /m:@NUM_JOBS@ /t:makedata "/p:Configuration=%~2" /p:Platform=x64 "/p:DefaultPlatformToolset=@CMAKE_VS_PLATFORM_TOOLSET@" "/p:WindowsTargetPlatformVersion=@CMAKE_VS_WINDOWS_TARGET_PLATFORM_VERSION@" /p:SkipUWP=true /p:CL_MPCount=@NUM_JOBS@ /p:VcpkgEnabled=false
exit /b %errorlevel%
